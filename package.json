{
  "name": "el-bot-template",
  "version": "0.0.1",
  "description": "el-bot 的快速启动模版",
  "private": true,
  "main": "bot/index.js",
  "mirai": {
    "folder": "mirai"
  },
  "scripts": {
    "bot": "nodemon --exec el bot",
    "dev": "nodemon --exec el bot",
    "mirai": "cd mirai && java -jar mirai-console-wrapper-1.3.0.jar --update KEEP",
    "start": "el start",
    "start:bot": "el start bot",
    "start:mirai": "el start mirai",
    "install:mirai": "el install mirai",
    "lint": "eslint --fix . && prettier --write .",
    "webhook": "el start webhook"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ElpsyCN/el-bot-template.git"
  },
  "author": {
    "name": "YunYouJun",
    "email": "me@yunyoujun.cn",
    "url": "https://www.yunyoujun.cn"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ElpsyCN/el-bot-template/issues"
  },
  "homepage": "https://github.com/ElpsyCN/el-bot-template#readme",
  "dependencies": {
    "@el-bot/plugin-hitokoto": "^0.0.11",
    "@el-bot/plugin-setu": "^0.0.12",
    "ascii2d": "^3.0.1",
    "axios": "^0.20.0",
    "download": "^8.0.0",
    "el-bot": "^0.3.21",
    "sagiri": "^3.1.0",
    "simple-netease-cloud-music": "^0.5.0",
    "string-random": "^0.1.3",
    "tracemoe-helper": "^1.0.3"
  },
  "devDependencies": {
    "dotenv": "^8.2.0",
    "eslint": "^7.6.0",
    "eslint-config-prettier": "^6.11.0",
    "nodemon": "^2.0.4",
    "prettier": "^2.0.5"
  }
}
